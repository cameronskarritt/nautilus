# Local development defaults only. Copy to .env before configuring secrets.
DEBUG=true
APP_ENV=development
APP_NAME="Nautilus" # Used for TOTP issuer and account names
APP_VERSION="0.1.0" # App version for version check feature
APP_BASE_URL="http://localhost:5173"
ADMIN_BASE_URL="http://localhost:5174"
API_BASE_URL="http://localhost:8080/api"
CORS_ALLOWED_ORIGINS="http://localhost:8080"
MAIL_SENDER_ADDRESS="noreply@example.com"

DATABASE_URL="postgres://app:password@postgres:5432/nautilus?sslmode=disable"
REDIS_URL="redis://redis:6379"

# Temporal (Compose overrides the address for app and worker containers)
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="nautilus"

# OpenSearch (Compose overrides the worker URL and index)
OPENSEARCH_URL="http://localhost:9200"
OPENSEARCH_INDEX="nautilus-documents-v1"
OPENSEARCH_VECTOR_INDEX="nautilus-documents-qwen3-4b-v1"
OPENSEARCH_USERNAME=""
OPENSEARCH_PASSWORD=""

# LM Studio embedding client; empty URL keeps keyword-only upload indexing.
EMBEDDING_URL=""
EMBEDDING_MODEL="text-embedding-qwen3-embedding-4b"
EMBEDDING_DIMENSIONS=2560
EMBEDDING_API_KEY=""
EMBEDDING_QUERY_INSTRUCTION=""

# LM Studio OCR; Compose uses the host server from the upload worker.
OCR_URL="http://localhost:1234/v1"
OCR_MODEL="allenai/olmocr-2-7b"
OCR_API_KEY=""

# SSO
SSO_SIGNING_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AWS / MiniStack
AWS_ENDPOINT_URL="http://ministack:4566"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
SES_CONFIGURATION_SET=""

# Encrypted document object storage
DOCUMENTS_BUCKET="nautilus-dev"
