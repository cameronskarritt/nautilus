# Local development defaults only. Copy to .env before configuring secrets.
DEBUG=true
APP_ENV=development
APP_NAME="Nautilus" # Used for TOTP issuer and account names
APP_VERSION="0.1.0" # App version for version check feature
APP_BASE_URL="http://localhost:8080"
API_BASE_URL="http://localhost:8080/api"
CORS_ALLOWED_ORIGINS="http://localhost:8080"
MAIL_SENDER_ADDRESS="noreply@example.com"

DATABASE_URL="postgres://app:password@postgres:5432/nautilus?sslmode=disable"
REDIS_URL="redis://redis:6379"

ENCRYPTION_KEY=""

# LLM providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# SSO
SSO_SIGNING_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AWS / MiniStack
AWS_ENDPOINT_URL="http://ministack:4566"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
SES_CONFIGURATION_SET=""
VAPID_PRIVATE_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_SUBSCRIBER="mailto:admin@example.com"
